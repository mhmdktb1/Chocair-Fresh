# ===============================================
# CHOUCAIR FRESH - BACKEND ENVIRONMENT VARIABLES
# ===============================================

# Server Environment
PORT=5001
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.kqoupel.mongodb.net/choucair_fresh?retryWrites=true&w=majority

# JWT Secret for User Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
# Optional dedicated key for OTP/grant HMACs; defaults to JWT_SECRET when omitted.
OTP_HASH_SECRET=your_separate_random_otp_hash_secret

# Supabase Storage for Permanent Image Uploads (Camera, Products, Avatars)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_BUCKET=Fresh.img

# Allowed Frontend Origins (comma-separated or single domain)
CLIENT_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Meta WhatsApp Cloud API
# Required in Render for OTP delivery; never put real credentials in this file.
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
# Must exactly match the approved template's language/locale code in Meta.
WHATSAPP_TEMPLATE_LANG=your_approved_template_language_code
# Defaults to chocair_otp if omitted.
WHATSAPP_OTP_TEMPLATE=chocair_otp
# Defaults to the latest Graph API version verified in Meta's changelog (v26.0).
WHATSAPP_GRAPH_API_VERSION=v26.0
# Required only when the WhatsApp webhook verification endpoint is enabled.
WHATSAPP_VERIFY_TOKEN=your_chosen_webhook_verify_token

# Telegram Instant Order Notifications (To Admin Phone)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=your_telegram_user_id_or_chat_id
