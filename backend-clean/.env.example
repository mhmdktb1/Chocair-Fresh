# ===============================================
# CHOCAIR FRESH - BACKEND ENVIRONMENT VARIABLES
# ===============================================

# Server Environment
PORT=5001
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.kqoupel.mongodb.net/chocair_fresh?retryWrites=true&w=majority

# JWT Secret for User Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Supabase Storage for Permanent Image Uploads (Camera, Products, Avatars)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_BUCKET=Fresh.img

# Allowed Frontend Origins (comma-separated or single domain)
CLIENT_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Meta WhatsApp Cloud API (Optional - Utility OTP & Receipts)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_OTP_TEMPLATE=jaspers_market_order_confirmation_v1

# Telegram Instant Order Notifications (To Admin Phone)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=your_telegram_user_id_or_chat_id
