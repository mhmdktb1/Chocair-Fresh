{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/shop/:id([0-9a-fA-F]{24})",
      "destination": "/api/category-redirect?id=:id"
    },
    {
      "source": "/shop/:slug",
      "destination": "/spa-fallback"
    },
    {
      "source": "/product/:id([0-9a-fA-F]{24})",
      "destination": "/spa-fallback"
    },
    {
      "source": "/category/:id([0-9a-fA-F]{24})",
      "destination": "/api/category-redirect?id=:id"
    },
    {
      "source": "/product/:slug",
      "destination": "/spa-fallback"
    },
    {
      "source": "/category/:slug",
      "destination": "/spa-fallback"
    }
  ],
  "headers": [
    {
      "source": "/assets/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(images|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|og-image\\.jpg|manifest\\.webmanifest|icons/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/((?!assets/|icons/|favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|og-image\\.jpg|manifest\\.webmanifest|sw\\.js|service-worker\\.js).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
